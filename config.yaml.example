# Kasa configuration
# Location: ~/.kasa/config.yaml

kubernetes:
  # Path to kubeconfig file (empty = default ~/.kube/config)
  kubeconfig: ""
  # Kubernetes context to use (empty = current context from kubeconfig)
  # The context name is also used as a subfolder for manifest storage,
  # so each cluster's manifests are kept separate.
  context: ""

agent:
  # Gemini model to use (default: gemini-3-flash-preview)
  model: gemini-3-flash-preview
  # Agent name (default: kasa)
  name: kasa
  # Maximum tool calls per turn before the agent is stopped (default: 25, 0 = unlimited)
  max_tool_calls: 25
  # Warn the model after this many calls to the same tool in one turn (default: 3, 0 = disabled)
  tool_warn_threshold: 3

deployments:
  # Directory where manifests are stored (supports ~ for home directory)
  # Default: ~/.kasa/deployments
  directory: ""
  # Git remote URL for team sync (e.g., git@github.com:org/manifests.git)
  # remote: ""

# API credentials
# Environment variables take precedence over these values.
credentials:
  # Required: Google API key for Gemini (or set GOOGLE_API_KEY env var)
  google_api_key: ""
  # Optional: Jina API key for web search and URL fetching (or set JINA_API_KEY env var)
  jina_api_key: ""

# Prompts for tuning (leave empty for built-in defaults)
# prompts:
#   system: |
#     Your custom system prompt here...
